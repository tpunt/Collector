{
  "name": "reddit-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "probe": "node src/probe.ts",
    "browser:install": "node src/install-browser.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:network": "node --test tests/network.integration.ts",
    "build": "vite build",
    "start": "node src/server.ts",
    "dev": "vite build --watch",
    "test:browser": "node --test tests/*.integration.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "playwright": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.0"
  }
}
